<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.1.0.0" name="DesktopOrganizer.app"/>

  <!-- Windows 10/11 feature declarations (supportedOS GUIDs per SDK docs). -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!--
        PerMonitorV2 is what makes the whole coordinate pipeline honest on mixed-DPI monitors:
        the desktop listview reports physical pixels, SystemParameters (virtual screen) stops
        being virtualized, and FenceWindow's TransformToDevice queries return the CURRENT
        monitor's scale instead of the system-wide one. Without this, WPF runs system-DPI-aware
        and overlay windows drift off the real icons on any secondary monitor with a different
        scale factor.
      -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
