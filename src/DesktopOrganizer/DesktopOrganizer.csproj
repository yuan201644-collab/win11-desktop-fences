<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DesktopOrganizer.Core\DesktopOrganizer.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- App icon for the .exe only. WPF resource packaging happens below; the duplicate entry used
         to live in <PropertyGroup> as <Resource>app.ico</Resource> which MSBuild silently ignored,
         causing a XamlParseException ("找不到资源 app.ico") at startup. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Declares PerMonitorV2 + longPathAware. Replaces the SDK's auto-generated default manifest,
         which is why the supportedOS compatibility section is spelled out in the file. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- A bare <Resource>app.ico</Resource> in <PropertyGroup> is NOT valid MSBuild and is dropped, so
         the icon never reached the WPF resource manifest and pack://application:,,,/app.ico failed
         at Window ctor time. Use the proper ItemGroup form so both pack:// and NotificationIconIcon
         can resolve the icon. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms/Drawing global usings collide with WPF (Application, MessageBox, Color, Brushes).
         We only need their types via explicit aliases (Forms.NotifyIcon, SystemIcons). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DesktopOrganizer.Tests" />
  </ItemGroup>

</Project>
