<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DesktopOrganizer.Core\DesktopOrganizer.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- App icon for the .exe and the WPF window. Sourced as a Resource so the runtime can
         load it from pack://application:,,,/app.ico for the NotifyIcon as well. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Resource>app.ico</Resource>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms/Drawing global usings collide with WPF (Application, MessageBox, Color, Brushes).
         We only need their types via explicit aliases (Forms.NotifyIcon, SystemIcons). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DesktopOrganizer.Tests" />
  </ItemGroup>

</Project>
