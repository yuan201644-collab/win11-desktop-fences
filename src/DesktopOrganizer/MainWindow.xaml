<Window x:Class="DesktopOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopOrganizer"
        mc:Ignorable="d"
        Title="MainWindow" Height="580" Width="800">
    <Grid>
        <!-- M2 PoC debug button — remove in M6 -->
        <Button Name="ArrangeDebugButton" Content="Arrange (M2 PoC)" Click="ArrangeDebugButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
        <Button Name="GroupButton" Content="整理并显示分组" Click="GroupButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="150,10,0,0" />
        <Button Name="RestoreButton" Content="恢复上次布局" Click="RestoreButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="290,10,0,0" />
        <TextBlock x:Name="SavedHint" Text="已保存" FontSize="13" Foreground="#2E7D32" FontWeight="SemiBold"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,16,0" Visibility="Collapsed" />

        <!-- Fence color tuning; rows are built in code-behind (one per OverlayAppearance channel). -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,46,0,0"
                Padding="10,10,10,8" BorderBrush="#22000000" BorderThickness="1" CornerRadius="6">
            <StackPanel x:Name="ColorSection" />
        </Border>

        <!-- Box edge padding (how far each box edge sits outside its icons); built in code-behind. -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,330,0,0"
                Padding="10,10,10,8" BorderBrush="#22000000" BorderThickness="1" CornerRadius="6">
            <StackPanel x:Name="InsetSection" />
        </Border>
    </Grid>
</Window>
