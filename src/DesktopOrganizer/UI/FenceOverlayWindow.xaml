<Window x:Class="DesktopOrganizer.UI.FenceOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FenceOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        IsHitTestVisible="False">
    <!-- The whole window is click-through; children are drawn on a bare Canvas in screen pixels (converted to DIPs). -->
    <Canvas x:Name="Root" Background="Transparent" />
</Window>