<UserControl x:Class="DesktopMediaController.Widget.WidgetCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Flat icon button: no chrome, a soft hover wash, and never any focus rectangle. The card
             lives on the desktop, so a focus ring would look like a rendering artefact. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3DFFFFFF" />
                            </Trigger>
                            <!-- A player that cannot do something gets an obviously dead button
                                 rather than a live one that silently does nothing. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.28" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ClipToBounds because the card is freely resizable: at a small size the lyric block must be
         cut off rather than drawn over the progress bar. -->
    <Border x:Name="Shell" CornerRadius="14"
            Background="#E81A1A20"
            BorderBrush="#4D87C5FF"
            BorderThickness="1"
            ClipToBounds="True">
        <!-- The margins are what the resize bands sit inside (see WidgetWindow.HitTestEdge), so nothing
             here may be closer than ~8px to an edge or the two would fight over the same pixels. -->
        <Grid Margin="12,10,10,10">
            <Grid.ColumnDefinitions>
                <!-- Width is assigned in code: the cover keeps its apparent size in step with the
                     card's height, and a square has to be sized in one place. -->
                <ColumnDefinition x:Name="CoverColumn" Width="64" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Cover art. The glyph stays as the placeholder for sources that publish no thumbnail
                 (and for the idle state); the Image sits on top once one decodes. -->
            <Border x:Name="CoverBorder" Grid.Column="0" Width="64" Height="64" CornerRadius="8"
                    Background="#26FFFFFF" ClipToBounds="True" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="CoverPlaceholder" Text="&#x266A;" FontSize="24"
                               Foreground="#8CFFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!-- The lyric block. Star-sized so it absorbs whatever extra height a resize gives
                         the card, instead of leaving the slack in one place. -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title + close. The close button is docked so a long title ellipsises before it. -->
                <DockPanel Grid.Row="0">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right"
                            Style="{StaticResource IconButton}"
                            Width="20" Height="20" Margin="6,0,0,0"
                            FontSize="10" Foreground="#B3FFFFFF"
                            Content="&#x2715;" ToolTip="隐藏到托盘（音乐继续播放，右键托盘图标退出）"
                            Click="OnCloseClick" />
                    <TextBlock x:Name="TitleText" Text="未连接到播放器"
                               FontSize="13.5" FontWeight="SemiBold" Foreground="#F2FFFFFF"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Artist, then a clickable source chip: with two players running, the automatic
                     choice cannot always be the wanted one, so switching is one click away. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="ArtistText" Text="打开播放器后自动显示" FontSize="11"
                               Foreground="#A6FFFFFF" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="SeparatorText" Text="  ·  " FontSize="11"
                               Foreground="#59FFFFFF" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <Button x:Name="SourceButton" Style="{StaticResource IconButton}"
                            Padding="5,1" FontSize="10" Foreground="#B3D6FF"
                            Visibility="Collapsed" Click="OnSourceClick"
                            ToolTip="点击切换到下一个播放器">
                        <TextBlock x:Name="SourceText" Text="" />
                    </Button>
                </StackPanel>

                <!-- Lyrics: the line being sung, with one either side for context. The active line is
                     one inline per character, so the card lights them up by changing colour and
                     nothing else — see WidgetCard.BuildRuns for why that matters.

                     The block only ever moves as a whole, and only through a RenderTransform, never a
                     LayoutTransform: a layout transform re-measures on every frame, which would put
                     back exactly the sideways twitch the per-character inlines exist to remove.

                     No wrapping: a wrapped line would grow into its neighbours and make the card's
                     height depend on the words, which a resizable window cannot afford. A long line
                     ellipsises instead.

                     The sizes below are the design values for the default 440x176 card; SetCardSize
                     recomputes all of them from the card's height so the block grows with the card and
                     still fits at the minimum size. -->
                <Grid Grid.Row="2" Margin="0,4,0,4" ClipToBounds="True">
                    <StackPanel x:Name="LyricLines" VerticalAlignment="Center" RenderTransformOrigin="0,0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="LyricShift" Y="0" />
                        </StackPanel.RenderTransform>
                        <TextBlock x:Name="LyricPrevious" Height="18" FontSize="13"
                                   Foreground="#59FFFFFF" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LyricCurrent" Height="31" FontSize="22"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LyricNext" Height="18" FontSize="13"
                                   Foreground="#59FFFFFF" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Shown instead of the three lines when there is nothing to scroll. The area
                         keeps its size either way, so the card never changes height on its own. -->
                    <TextBlock x:Name="LyricStatus" VerticalAlignment="Center"
                               FontSize="13" Foreground="#73FFFFFF"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </Grid>

                <!-- Read-only progress. Two star columns rather than a ProgressBar: the ratio is then
                     set directly and there is no control template to fight with. QQ音乐 reports
                     seek=false, so a draggable bar would be a lie. -->
                <Grid Grid.Row="3" Height="4" Margin="0,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProgressFilledColumn" Width="0*" />
                        <ColumnDefinition x:Name="ProgressRemainingColumn" Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="#33FFFFFF" />
                    <Border x:Name="ProgressFill" Grid.Column="0" CornerRadius="2"
                            Background="#87C5FF" />
                </Grid>

                <DockPanel Grid.Row="4" Margin="0,6,0,0" VerticalAlignment="Bottom">
                    <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Text="" FontSize="10"
                               Foreground="#8CFFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PreviousButton" Style="{StaticResource IconButton}"
                                Width="30" Height="26" Margin="0,0,4,0"
                                ToolTip="上一首" Click="OnPreviousClick">
                            <Path Fill="#E6FFFFFF" Data="M1,1 H2.6 V11 H1 Z M11,1 L3.6,6 L11,11 Z" />
                        </Button>
                        <Button x:Name="ToggleButton" Style="{StaticResource IconButton}"
                                Width="30" Height="26" Margin="0,0,4,0"
                                Click="OnToggleClick">
                            <Path x:Name="ToggleIcon" Fill="#F2FFFFFF" Data="M2,1 L11,6 L2,11 Z" />
                        </Button>
                        <Button x:Name="NextButton" Style="{StaticResource IconButton}"
                                Width="30" Height="26"
                                ToolTip="下一首" Click="OnNextClick">
                            <Path Fill="#E6FFFFFF" Data="M1,1 L8.4,6 L1,11 Z M9.4,1 H11 V11 H9.4 Z" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
