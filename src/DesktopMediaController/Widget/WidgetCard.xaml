<UserControl x:Class="DesktopMediaController.Widget.WidgetCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="14"
            Background="#E81A1A20"
            BorderBrush="#4D87C5FF"
            BorderThickness="1">
        <Grid Margin="12,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
            </Grid.ColumnDefinitions>

            <!-- Cover-art placeholder. Phase 2 replaces the glyph with the SMTC thumbnail. -->
            <Border Grid.Column="0" CornerRadius="8" Background="#26FFFFFF" Margin="0,0,12,0">
                <TextBlock Text="♪" FontSize="24" Foreground="#8CFFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="未连接到播放器"
                           FontSize="13.5" FontWeight="SemiBold" Foreground="#F2FFFFFF"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText" Text="Phase 1 · 骨架窗口" FontSize="11"
                           Foreground="#A6FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            </StackPanel>

            <Button x:Name="CloseButton" Grid.Column="2"
                    Width="22" Height="22" Padding="0" FontSize="10"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Content="✕" Foreground="#B3FFFFFF" Background="Transparent"
                    BorderThickness="0" Focusable="False" Cursor="Hand"
                    ToolTip="关闭桌面媒体控制器" Click="OnCloseClick" />
        </Grid>
    </Border>
</UserControl>
